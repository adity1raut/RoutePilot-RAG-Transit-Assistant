# Copy to .env and fill in ONE of the API keys.
# Without a key RoutePilot still works: it answers with the retrieved information directly.

# auto | anthropic | gemini | openai | none   (auto = whichever key is set, Claude first)
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max - how much Claude thinks before answering
ANTHROPIC_EFFORT=medium

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# set to true only for Vertex AI express-mode keys
GOOGLE_VERTEXAI=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# leave empty for OpenAI; set it to use any OpenAI-compatible API with the key above, e.g. free Groq
# (key from console.groq.com/keys): OPENAI_BASE_URL=https://api.groq.com/openai/v1, OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_BASE_URL=

# Retrieval settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=80
